{
  "name": "site-accelerator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:tokens": "node scripts/check-color-literals.mjs",
    "cms:push": "node scripts/cms-push.mjs",
    "cms:push:dry": "node scripts/cms-push.mjs --dryRun",
    "cms:push:bootstrap": "node scripts/cms-push.mjs --ignore-circular-dependency",
    "cms:pull": "node --env-file=.env.$(git branch --show-current | tr / -) node_modules/@optimizely/cms-cli/bin/run.js config pull",
    "catalog:push": "node scripts/catalog/push-catalog.mjs",
    "catalog:push:dry": "node scripts/catalog/push-catalog.mjs --dryRun",
    "catalog:reset": "node scripts/catalog/push-catalog.mjs --reset",
    "fx:events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fx/print-events.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check:feeds": "tsx scripts/check-feeds.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@optimizely/cms-cli": "^3.1.0",
    "@optimizely/cms-sdk": "^3.1.0",
    "@optimizely/optimizely-sdk": "^6.6.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/mapbox-gl": "^3.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "5.11.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.25.0",
    "next": "16.3.5",
    "next-intl": "^4.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.0",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "yarn@3.8.7",
  "engines": {
    "node": ">=22.23.4"
  }
}
